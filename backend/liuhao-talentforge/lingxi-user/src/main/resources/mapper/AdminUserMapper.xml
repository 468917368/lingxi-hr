<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lingxi.user.mapper.AdminUserMapper">

    <resultMap id="BaseResultMap" type="AdminUser">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password_hash" property="passwordHash"/>
        <result column="name" property="name"/>
        <result column="status" property="status"/>
        <result column="first_login" property="firstLogin"/>
        <result column="last_login_at" property="lastLoginAt"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, username, password_hash, name, status, first_login, last_login_at, created_at, updated_at
    </sql>

    <!-- 根据ID查询 -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM admin_user
        WHERE id = #{id}
    </select>

    <!-- 根据用户名查询 -->
    <select id="selectByUsername" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM admin_user
        WHERE username = #{username}
    </select>

    <!-- 更新记录 -->
    <update id="updateById">
        UPDATE admin_user
        <set>
            <if test="passwordHash != null">password_hash = #{passwordHash},</if>
            <if test="name != null">name = #{name},</if>
            <if test="status != null">status = #{status},</if>
            <if test="firstLogin != null">first_login = #{firstLogin},</if>
            <if test="lastLoginAt != null">last_login_at = #{lastLoginAt},</if>
            updated_at = NOW()
        </set>
        WHERE id = #{id}
    </update>

</mapper>
