# ============================================================
# 灵犀互聘 部署环境变量模板
# 复制为 .env（两台服务器各一份，值相同），只需填 BACKEND_IP
#   cp .env.example .env
# OSS 已用 dev 那套 key/bucket 填好，无需改动
# ============================================================

# 8G 后端机内网 IP（MySQL/Redis/Nacos/RocketMQ/7 业务服务都在这台）
BACKEND_IP=172.17.24.42

# 4G 前端机内网 IP（nginx，仅作标识；脚本用不到，BACKEND_IP 才是反代目标）
FRONT_IP=172.31.40.171

# 阿里云 OSS（dev 那套 key/bucket；字段名以代码 MinioUtil 读取的 access-key-id/secret-key 为准）
OSS_ENDPOINT=oss-cn-guangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=your-oss-access-key-id
OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret
OSS_BUCKET_NAME=lingxi-h
